# 统一换行符：仓库内一律存 LF，避免 Windows / Unix 协作者之间产生无意义的整文件 diff
* text=auto eol=lf

# 明确二进制文件，防止 Git 尝试做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.wasm binary
*.gz  binary
*.tgz binary
*.zip binary

# 文档与源码按文本处理
*.md   text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.txt  text eol=lf
