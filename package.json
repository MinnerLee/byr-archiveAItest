{
  "name": "byr-archive",
  "version": "1.2.0",
  "description": "BYR Archive —— 一个最简版的 jsDelivr：从 npm registry 拉取包并直接对外提供文件、目录与入口文件服务",
  "type": "module",
  "engines": {
    "node": ">=18.17.0"
  },
  "bin": {
    "byr-archive": "./src/index.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./server": "./src/server.js",
    "./store": "./src/store.js",
    "./semver": "./src/semver.js",
    "./minify": "./src/minify.js",
    "./bundle": "./src/bundle.js",
    "./api": "./src/api.js"
  },
  "files": [
    "src",
    "test",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node test/smoke.mjs",
    "test:acceptance": "node test/acceptance.mjs",
    "bench": "node test/benchmark.mjs",
    "cli": "node src/index.js",
    "verify:lodash": "node src/index.js verify lodash",
    "verify:vue": "node src/index.js verify vue@3.3.4"
  },
  "keywords": [
    "jsdelivr",
    "cdn",
    "npm",
    "registry",
    "proxy",
    "tarball",
    "semver"
  ],
  "license": "MIT",
  "dependencies": {}
}
